# Data and model files are re-creatable and too large for Git (D-002).
# The leading "/" anchors each pattern to the repository root. Without it,
# "data/" would also match the code folder ribomamba/data/ (it did, once).
/data/
/checkpoints/
/samples/

# Python build/run by-products
__pycache__/
*.egg-info/
.pytest_cache/

# Claude Code's local tool permissions (per machine, not part of the project)
/.claude/

# Teaching drafts prepared ahead of a phase's concept block (not taught yet; kept out of Git so
# editing them never makes a training run's recorded commit "-dirty")
/drafts/

# Pinned third-party baseline checkouts (see ribomamba/design/baselines.py; not redistributed)
/external/
